{
  "name": "youtube-agent-remotion",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render:sample": "remotion render src/index.ts YouTubeVideo out/sample.mp4",
    "still": "remotion still src/index.ts YouTubeVideo out/thumbnail.png",
    "render:project": "remotion render src/index.ts YouTubeVideo out/youtube-video.mp4 --props-file=public/props.json",
    "render:sleep": "remotion render src/index.ts SleepVideo out/moonlight-ocean-dreams.mp4 --props-file=public/sleep-props.json"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/web-renderer": "4.0.539",
    "remotion": "4.0.539",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.6.0"
  }
}
